    "b=60_000\n",
    "\n",
    "def utility(w,theta,b=b):\n",
    "    if theta == 0:\n",
    "        u=w\n",
    "    else:\n",
    "        if w >=b:\n",
    "            u=(w**(1-theta)-1)/(1-theta) \n",
    "        else:\n",
    "            u=((b**(1-theta)-1)/(1-theta))*w\n",
    "    return u"
   ]
